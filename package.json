{
  "name": "@dirgha/code",
  "version": "2.0.0",
  "description": "Dirgha Code v2.0 (2.0.0) — Sovereign Coding CLI & TUI, <1ms Lokahi WASM Capability Firewall, 235+ Provider Router, Physical AI MuJoCo CI, and 29-Tool MCP Server.",
  "license": "Apache-2.0",
  "author": "Salik Shah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dirgha-AI/dirgha.git"
  },
  "homepage": "https://github.com/Dirgha-AI/dirgha",
  "bugs": {
    "url": "https://github.com/Dirgha-AI/dirgha/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dirgha": "./bin/dirgha.mjs",
    "dirgha-code": "./bin/dirgha.mjs",
    "dirgha-native-host": "./bin/dirgha.mjs"
  },
  "files": [
    "bin/dirgha.mjs",
    "bin/build-native.mjs",
    "dist/",
    "scaffold-templates/",
    "vendor/",
    "extensions/firefox-mv3/lokahi_gate.wasm",
    "extensions/firefox-mv3/manifest.json",
    "extensions/firefox-mv3/background.js",
    "extensions/firefox-mv3/content-agent-dom.js",
    "include/dirgha_kernel.h",
    "plugins/dsh-plugin-dirgha/",
    "plugins/robotics-physical-ai/plugin.toml",
    "plugins/robotics-physical-ai/mujoco_eval_sidecar.py",
    "plugins/robotics-skills-pack/plugin.toml",
    "README.md",
    "CHANGELOG.md",
    "CREDITS.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs && node scripts/patch-ink-text-input.mjs",
    "build:native": "node ./bin/build-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src && node --test ./bin/dirgha.test.mjs",
    "doctor": "node ./bin/dirgha.mjs doctor",
    "prepublishOnly": "npm run build && npm test"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "12.9.0",
    "chokidar": "^5.0.0",
    "kokoro-js": "^1.2.1",
    "sqlite-vec": "^0.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "dirgha",
    "cli",
    "coding-agent",
    "llm",
    "byok",
    "agent",
    "mcp",
    "robotics",
    "mujoco",
    "lerobot",
    "security",
    "sarif",
    "sbom",
    "wasm",
    "openrouter",
    "anthropic",
    "openai"
  ],
  "dependencies": {
    "ink": "^7.0.2",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.11.5",
    "@types/react": "^19.3.0",
    "eslint": "9.39.4",
    "license-checker": "25.0.1",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "3.2.4"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "protobufjs": ">=7.5.5",
    "sharp": "^0.35.5"
  }
}
